# Portable CrazyGames HTML5 distribution build. These values are public build
# switches, not credentials.
VITE_DISTRIBUTION_CHANNEL=crazygames

# One menu surface switch: off | rewarded-skin | currency-store.
# Keep it off during Basic Launch. `rewarded-skin` additionally requires the
# rewarded capability gate below; `currency-store` requires both IAP gates.
VITE_CRAZYGAMES_MENU_MONETIZATION=off

# CrazyGames disables ads in Basic Launch and rejects visible rewarded buttons
# that cannot deliver.
VITE_CRAZYGAMES_REWARDED_ENABLED=false

# IAP is invite-only on CrazyGames. Both gates stay closed until CrazyGames
# authorizes the title and provides its Xsolla project setup.
VITE_CRAZYGAMES_IAP_AUTHORIZED=false
VITE_CRAZYGAMES_STORE_LAYOUT=disabled

# Wormifi.com uses its own consent-gated GA4 stream. The CrazyGames package
# relies on the platform dashboard and SDK lifecycle instead of injecting GA4.
VITE_GA4_MEASUREMENT_ID=

# Absolute arena address. Required for any build a portal hosts on its own
# domain. Without it the client falls back to wss://<window.location.host>/arena,
# which resolves to the portal's domain inside their iframe and never reaches
# Wormifi. A portal build must never guess the host from the page.
VITE_ARENA_WS_URL=wss://wormifi.com/arena
