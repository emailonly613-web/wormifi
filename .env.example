# Optional. Leave blank to keep Google Analytics fully disabled.
# Supply the real GA4 Web data-stream Measurement ID only in the deployment
# environment after owner privacy and consent settings are reviewed.
VITE_GA4_MEASUREMENT_ID=

# Distribution defaults. `owned-web` keeps all CrazyGames code dormant.
VITE_DISTRIBUTION_CHANNEL=owned-web

# One menu surface switch: off | rewarded-skin | currency-store.
# A surface still fails closed unless its capability gate below is also true.
VITE_CRAZYGAMES_MENU_MONETIZATION=off

# Enable only after CrazyGames approves Full Launch and rewarded placements.
VITE_CRAZYGAMES_REWARDED_ENABLED=false
VITE_CRAZYGAMES_IAP_AUTHORIZED=false
VITE_CRAZYGAMES_STORE_LAYOUT=disabled
