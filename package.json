{
  "name": "wormifi",
  "version": "0.1.0",
  "private": true,
  "description": "Wormifi original living-chain arena",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:crazygames": "tsc -b && vite build --mode crazygames && node scripts/verify-crazygames-build.mjs",
    "package:crazygames": "pnpm build:crazygames && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-crazygames.ps1",
    "preview": "vite preview --host 0.0.0.0",
    "preview:crazygames": "vite preview --mode crazygames --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "test:soak": "vitest run tests/soak.test.ts --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test --config=playwright.accessibility.config.ts",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:multiplayer": "playwright test --config=playwright.multiplayer.config.ts",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "atlas:ground:generate": "node scripts/generate-ground-treasure-atlases.mjs",
    "og:generate": "node scripts/generate-og-card.mjs",
    "og:verify": "node scripts/verify-og-card.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "verify:deployment-identity": "node scripts/verify-deployment-identity.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
